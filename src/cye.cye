// cye.cye

// BUILD:
// 1. cye -o cye.c ./src/cye.cye 
// 2. gcc -mconsole -nostdlib -o cye.exe -e_start -Wall -Wextra -std=c89 -pedantic cye.c -lkernel32
//  OR
// 2. tcc -o cye.exe cye.c
// NOTE: tcc automatically detects _start as the entry-point

// You don't have a Cye compiler??? Bootstrap it:
// 0. gcc -mconsole -nostdlib -o cye.exe -e_start -Wall -Wextra -std=c89 -pedantic ./bootstrap/autogenerated.c -lkernel32

// TODO:
// - make sure c_name doesn't use the same name twice
// - fix the warning "set but not used" in auto-generated C code
// - fix the warning "statement with no effect" in auto-generated C code
// - add postfix versions of prefix +, -, and ^ operators
// - conditional compilation alternative to #if
// - proper integer promotion
// - use dynamic arrays sometimes instead of arenas, bacause allocating a chunk of virtual address space is not always a good idea
// - fix type_equal for structs (test/005_string_constant.cye doesn't even compile)

//-------------------------------------------------------------------------------------------------
// cye.cye
//-------------------------------------------------------------------------------------------------

g_option_print_actual_names : u64;

main : () -> void
{
  console_init();
  
  g_option_print_actual_names = 1;
  
  eternal_arena = arena_create(1024 * 1024 * 1024); // 1 GB
  construction_arena = arena_create(1024 * 1024 * 1024); // 1 GB
  
  input_directory_arena = arena_create(1024 * 1024 * 1024); // 1 GB
  source_arena = arena_create(1024 * 1024 * 1024); // 1 GB
  c89_sorted_typedefs_arena = arena_create(1024 * 1024 * 1024); // 1 GB
  
  // allow no directory (in other words: allow absolute paths)
  {
    empty : String; empty = "";
    arena_push_copy(input_directory_arena, size_of(String), empty.&);
  }
  
  // parse command-line arguments:
  input_files : String_Array;
  output_path : String; output_path = "a.c";
  {
    input_files_con : Construction; input_files_con = construction_begin(construction_arena);
  
    argument_array : String_Array; argument_array = command_get_arguments();
    
    c_for argument_index : s64; argument_index < argument_array.count; argument_index += 1;
    {
      argument : String; argument = argument_array.at[argument_index];
      
      if string_equal(argument, "-o")
      {
        error_assert(__dbgpos, argument_index + 1 < argument_array.count);
        argument_index += 1;
        output_path = argument_array.at[argument_index];
      }
      else if string_equal(argument, "-I")
      {
        error_assert(__dbgpos, argument_index + 1 < argument_array.count);
        argument_index += 1;
        arena_push_copy(input_directory_arena, size_of(String), argument_array.at[argument_index].&);
      }
      else
      {
        arena_push_copy(input_files_con.arena, size_of(String), argument.&);
      }
    }
    
    input_files.count = construction_get_size(input_files_con) / size_of(String);
    input_files.at = construction_to_eternal_then_end(input_files_con);
  }
  
  if input_files.count == 0  complain(0, null, "no input files");
  
  // print the task
  if 0
  {
    console_error_print_string("  TASK:\ninput:\n");
    
    c_for i: s64; i < input_files.count; i += 1;
    {
      console_error_print_string("  ");
      console_error_print_string(input_files.at[i]);
      console_error_print_string("\n");
    }
    
    console_error_print_string("output:\n  ");
    console_error_print_string(output_path);
    console_error_print_string("\n\n");
  }
  
  // prepare builtin types
  
  builtin_type_u8   = type_create(TYPE_U8  , null);
  builtin_type_u16  = type_create(TYPE_U16 , null);
  builtin_type_u32  = type_create(TYPE_U32 , null);
  builtin_type_u64  = type_create(TYPE_U64 , null);
  builtin_type_s8   = type_create(TYPE_S8  , null);
  builtin_type_s16  = type_create(TYPE_S16 , null);
  builtin_type_s32  = type_create(TYPE_S32 , null);
  builtin_type_s64  = type_create(TYPE_S64 , null);
  builtin_type_void = type_create(TYPE_VOID, null);
  
  builtin_type_ptr_to_void = type_create(TYPE_POINTER_TO, null);
  builtin_type_ptr_to_void.sub_type = builtin_type_void;
  
  builtin_type_ptr_to_u8 = type_create(TYPE_POINTER_TO, null);
  builtin_type_ptr_to_u8.sub_type = builtin_type_u8;
  
  builtin_type_string = type_create(TYPE_STRUCT, null);
  builtin_type_string.c89_struct_name = "String";
  builtin_type_string.num_members = 2;
  builtin_type_string.members = eternal_push(builtin_type_string.num_members * size_of(Name_And_Type));
  builtin_type_string.members[0].type = builtin_type_ptr_to_u8;
  builtin_type_string.members[0].c89_name = "at";
  builtin_type_string.members[0].name = "at";
  builtin_type_string.members[1].type = builtin_type_s64;
  builtin_type_string.members[1].c89_name = "size";
  builtin_type_string.members[1].name = "size";
  
  // front end
  
  root : *Ast_Node; root = language_frontend(input_files);
  
  // generate C
  output_arena : *Arena;
  output_arena = arena_create(1024 * 1024 * 1024); // 1 GB
  
  c89_backend(root, output_arena);
  
  ok_1 : u64; ok_1 = file_write_all_bytes(output_path, output_arena.pushed, output_arena.at);
  resource_assert(__dbgpos, ok_1);
  
  // the end:
  console_error_print_string("SUCCESS!\n");
}

c_include_once "c89_backend.cye";
c_include_once "frontend.cye";
c_include_once "parser.cye";
c_include_once "notlibc.cye";
c_include_once "windows_kernel32.cye";


