// cye.cye

// BUILD:
// 1. cye -o cye.c cye.cye 
// 2. gcc -mconsole -nostdlib -o cye.exe -e_start -Wall -Wextra -std=c89 -pedantic cye.c -lkernel32
//  OR
// 2. tcc -o cye.exe cye.c
// NOTE: tcc automatically detects _start as the entry-point

// You don't have a Cye compiler? Bootstrap it!

// TODO:
// - make sure c_name doesn't use the same name twice
// - fix the warning "set but not used" in auto-generated C code
// - fix the warning "statement with no effect" in auto-generated C code
// - fix struct requiring being declared at the top of the source file
// - add postfix versions of prefix +, -, and ^ operators
// - remove c_string construct from the language
// - conditional compilation alternative to #if

// structs

c_typedef Arena : struct
{
  at       : *u8;
  pushed   : s64;
  commited : s64;
  reserved : s64;
};

c_typedef Token : struct
{
  at         : *u8;
  size       : s64;
  token_kind : s64;
  file       : *u8;
};


c_typedef Type : struct
{
  type_kind : s64;
  token : *Token;
  name_token_opt : *Token;
  c_name_opt : *u8;
  struct_c_name : *u8;
  
  sub_type : *Type;
  
  num_params : s64;
  params     : **Type;
  
  num_members : s64;
  members     : **Type;
};

c_typedef Symbol : struct
{
  token           : *Token;
  type            : *Type;
  ast_node_as_void_ptr : *void; // TODO: type *Ast_Node
  c_name_string   : *u8;
  c_extern_token  : *Token;
  c_typedef_token : *Token;
  storage         : s64;
  local_is_active : u64; // STORAGE_LOCAL only
  num_uses        : s64;
  c_enum_value    : s64; // STORAGE_C_ENUM only
};

c_typedef Parser : struct
{
  before_first : *Token;
  after_last   : *Token;
  tokens       : *Token;
  num_tokens   : s64;
  index        : s64;
};

c_typedef Scope : struct
{
  symbols     : **Symbol;
  num_symbols : s64;
  parent      : *Scope;
};

c_typedef Expr_Value : struct
{
  token        : *Token;
  type         : *Type;
  as_u64       : u64;
  is_lvalue    : u64;
  is_constexpr : u64;
};

c_typedef Ast_Node : struct
{
  node_kind : s64;
  token     : *Token;

  expr_0 : *Ast_Node;
  // unary
  // lhs in binary
  // function in a call
  // return value (opt.)
  // return type (opt.)
  // condition in while/do-while/if
  // c_for init
  
  expr_1 : *Ast_Node;
  // rhs in binary
  // c_for condition
  
  expr_2 : *Ast_Node;
  // c_for reinit
  
  stmt_0 : *Ast_Node;
  // function body
  // if true
  // while
  // do-while
  // break with (opt.)
  // continue with (opt.)
  // c_for
  
  stmt_1 : *Ast_Node;
  // else
  
  num_items : s64;
  items     : **Ast_Node;
  // arguments
  // parameters
  // statements
  // globals
  
  symbol_by_name : *Symbol; // node_kind == `node primary name`
  
  value : Expr_Value;
  scope : Scope; // node_kind == `node statement root` or == `node statement list` or == `node statement c_for`
  
  struct_c_name : *u8;
};

c_enum
{
  COMPLAIN_FATAL_ERROR;
  COMPLAIN_NOTE;
  COMPLAIN_WARNING;
  COMPLAIN_ERROR;
  COMPLAIN_ENUM_COUNT;
}

c_enum // Symbol.storage
{
  STORAGE_UNDEFINED;
  STORAGE_STATIC;
  STORAGE_EXTERN;
  STORAGE_LOCAL;
  STORAGE_C_TYPEDEF;
  STORAGE_C_ENUM;
}

