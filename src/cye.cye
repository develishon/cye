{
  // misc.:
  `token invalid`;
  `token integer`;
  `token string`;
  `token character`;
  `token name`;
  // keywords:
  `token u8`;
  `token s8`;
  `token or`;
  `token if`;
  `token do`;
  `token u64`;
  `token u32`;
  `token u16`;
  `token s64`;
  `token s32`;
  `token s16`;
  `token f64`;
  `token f32`;
